# Copy to providers/secrets.env (gitignored) and fill in.
# Sourced by scripts/start-test-server.sh to configure the test server's providers.
# Keys are read by the SERVER at startup (a client-shell key means nothing to it),
# so they must be exported into the server process — which the start script does.

# ---- Cloud provider keys ----
# Claude / Anthropic
export ANTHROPIC_API_KEY="sk-ant-..."
# ChatGPT / OpenAI  (needs a project/key with model access, e.g. gpt-4o)
export OPENAI_API_KEY="sk-..."

# ---- Local LLM endpoints (loki / spartacus) ----
# Reachable over mDNS (.local), WireGuard, or Tailscale — swap the host for your
# WG IP or Tailscale MagicDNS name if .local isn't resolvable on the server host.
#
# The server binds ONE ollama baseURL and ONE litellm baseURL at a time.
# Point OLLAMA_BASE_URL at whichever host you want for direct ollama/* models,
# and LITELLM_BASE_URL at a router (spartacus is the superset).

export OLLAMA_BASE_URL="http://loki.local:11434"
export LITELLM_BASE_URL="http://spartacus.local:4000"
# On-LAN routers here need no auth; set a placeholder (some builds require non-null).
export LITELLM_API_KEY="sk-noauth"

# ---- Alternate hosts (uncomment to switch) ----
# export OLLAMA_BASE_URL="http://spartacus.local:11434"
# export LITELLM_BASE_URL="http://loki.local:4000"
# WireGuard / Tailscale examples:
# export OLLAMA_BASE_URL="http://loki:11434"          # tailscale MagicDNS
# export OLLAMA_BASE_URL="http://100.x.y.z:11434"     # wireguard/tailscale IP
